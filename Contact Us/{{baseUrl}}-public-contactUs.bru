meta {
  name: {{baseUrl}}/public/contactUs
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/public/contactUs
  body: json
  auth: inherit
}

body:json {
  {
    "adminId":"{{adminId}}",
    "firstName": "Mahesh",
