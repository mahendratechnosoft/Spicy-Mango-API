meta {
  name: Get hotel availability data
  type: http
  seq: 7
}

get {
  url: {{stay_flexy_baseUrl}}/hoteldetailadvanced?hotelId={{hotelId}}&checkin=17-02-2026 00:00:00&checkout=18-02-2026 00:00:00&discount=0
  body: none
  auth: none
}

params:query {
  hotelId: {{hotelId}}
  checkin: 17-02-2026 00:00:00
  checkout: 18-02-2026 00:00:00
  discount: 0
}

headers {
  X-SF-API-KEY: {{stay_flexy_api_key}}
}

settings {
  encodeUrl: true
  timeout: 0
}
