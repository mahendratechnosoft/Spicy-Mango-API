meta {
  name: {{baseUrl}}/{{role}}/getAllProperties
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/{{role}}/getAllProperties?page=0&size=10&search=can
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 10
  search: can
  ~propertyType: Villa
  ~city: Bangalore
}

settings {
  encodeUrl: true
  timeout: 0
}
